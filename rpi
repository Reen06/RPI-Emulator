#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
source "$SCRIPT_DIR/lib/common.sh"
source "$SCRIPT_DIR/lib/docker_exec.sh"

OS_LIST_URL="https://downloads.raspberrypi.com/os_list_imagingutility_v3.json"

# Returns path to qemu-img, either native or via docker wrapper
qemu_img() {
    if command -v qemu-img &>/dev/null; then
        qemu-img "$@"
    else
        docker run --rm \
            -v "$(pwd):/work" -w /work \
            -v "$DISKS_DIR:$DISKS_DIR" \
            -v "$IMAGES_DIR:$IMAGES_DIR" \
            ubuntu:24.04 bash -c "apt-get install -qq -y qemu-utils 2>/dev/null; qemu-img $*"
    fi
}

# ── cmd: list ─────────────────────────────────────────────────────────────────

cmd_list() {
    echo ""
    echo "=== Local Images ($IMAGES_DIR) ==="
    if compgen -G "$IMAGES_DIR/*.img" &>/dev/null; then
        printf "  %-50s %8s  %s\n" "Name" "Size" "Modified"
        printf "  %-50s %8s  %s\n" "----" "----" "--------"
        for img in "$IMAGES_DIR"/*.img; do
            local size mod display
            size=$(du -sh "$img" 2>/dev/null | cut -f1)
            mod=$(date -r "$img" "+%Y-%m-%d %H:%M" 2>/dev/null || stat -c %y "$img" | cut -d' ' -f1,2 | cut -d'.' -f1)
            display=$(_image_display_name "$img")
            printf "  %-50s %8s  %s\n" "$display" "$size" "$mod"
        done
    else
        info "No images found. Run: rpi download"
    fi

    echo ""
    echo "=== Running Instances ==="
    local running=0
    local lan_ip; lan_ip=$(hostname -I 2>/dev/null | awk '{print $1}')
    for pid_file in /tmp/rpi-*.pid; do
        [[ -e "$pid_file" ]] || continue
        local pid name
        pid=$(cat "$pid_file")
        name=$(basename "$pid_file" .pid | sed 's/^rpi-//')
        if kill -0 "$pid" 2>/dev/null; then
            info "$name  (pid $pid)"
            info "  SSH: ssh -p $SSH_PORT ${DEFAULT_USER}@${lan_ip:-localhost}"
            local ports_file="$CONFIGS_DIR/${name}.ports"
            if [[ -f "$ports_file" ]]; then
                while IFS= read -r _line; do
                    _line="${_line%%#*}"; _line="${_line// /}"
                    [[ "$_line" =~ ^([0-9]+):([0-9]+)$ ]] || continue
                    [[ "${BASH_REMATCH[1]}" == "$SSH_PORT" ]] && continue
                    info "  http://${lan_ip:-localhost}:${BASH_REMATCH[1]}  →  guest:${BASH_REMATCH[2]}"
                done < "$ports_file"
            fi
            running=$((running + 1))
        else
            rm -f "$pid_file"
        fi
    done
    [[ $running -eq 0 ]] && info "None"
    echo ""
}

# ── cmd: label ────────────────────────────────────────────────────────────────

cmd_label() {
    [[ $# -ge 1 ]] || die "Usage: rpi label <label> [image]"
    local new_label="$1"
    [[ "$new_label" =~ ^[A-Za-z0-9_-]+$ ]] || \
        die "Label must be alphanumeric with hyphens/underscores only: $new_label"

    local img
    if [[ -n "${2:-}" ]]; then
        img=$(_parse_image_arg "$2")
        [[ -n "$img" ]] || img="$IMAGES_DIR/$2"
        [[ -f "$img" ]] || die "Image not found: $2"
    else
        img=$(pick_image)
    fi

    local old_base; old_base=$(basename "$img" .img)
    local old_slug; old_slug=$(slug "$img")

    # Strip existing label to get the original (unlabelled) base name
    local orig_name
    if [[ "$old_base" == *__* ]]; then
        orig_name="${old_base#*__}"
    else
        orig_name="$old_base"
    fi

    local new_filename="${new_label}__${orig_name}.img"
    local new_path="$IMAGES_DIR/$new_filename"

    if [[ "$img" == "$new_path" ]]; then
        info "Label already set to: $new_label"
        return
    fi

    mv "$img" "$new_path"
    info "Labelled: $(basename "$img") → $new_filename"

    # Rename associated disk/kernel dir/configs if they exist
    local old_disk="$DISKS_DIR/${old_slug}.qcow2"
    local new_disk="$DISKS_DIR/${new_label}.qcow2"
    local old_kdir="$KERNELS_DIR/${old_slug}"
    local new_kdir="$KERNELS_DIR/${new_label}"

    if [[ -f "$old_disk" && "$old_disk" != "$new_disk" ]]; then
        mv "$old_disk" "$new_disk"
        info "Renamed disk: $(basename "$old_disk") → $(basename "$new_disk")"
    fi
    if [[ -d "$old_kdir" && "$old_kdir" != "$new_kdir" ]]; then
        mv "$old_kdir" "$new_kdir"
        info "Renamed kernels: $(basename "$old_kdir") → $(basename "$new_kdir")"
    fi
    for _ext in ports machine creds; do
        local _old="$CONFIGS_DIR/${old_slug}.${_ext}"
        local _new="$CONFIGS_DIR/${new_label}.${_ext}"
        if [[ -f "$_old" && "$_old" != "$_new" ]]; then
            mv "$_old" "$_new"
            info "Renamed config: $(basename "$_old") → $(basename "$_new")"
        fi
    done
}

# ── cmd: download ─────────────────────────────────────────────────────────────

cmd_download() {
    command -v curl &>/dev/null || die "curl not found"
    command -v wget &>/dev/null || die "wget not found"

    echo ""
    echo "=== Fetching Raspberry Pi OS catalog... ==="
    local tmp
    tmp=$(mktemp /tmp/rpi-os-list.XXXXXX.json)
    curl -sf "$OS_LIST_URL" -o "$tmp" || die "Failed to fetch OS list"

    # Probe emulation capabilities once up front
    local _emu64=0 _emu32=0
    _qemu_supports_machine qemu-system-aarch64 raspi3b 2>/dev/null && _emu64=1
    _qemu_supports_machine qemu-system-arm     raspi2b 2>/dev/null && _emu32=1

    local entries
    entries=$(jq -r '
      [.os_list[] |
        (if .subitems then .subitems[] else . end) |
        select(.url?) |
        {name, url}
      ] | to_entries[] |
      "\(.key+1)\t\(.value.name)\t\(.value.url)"
    ' "$tmp")

    echo ""
    echo "Available images:"
    echo ""
    local max_idx=0
    while IFS=$'\t' read -r idx name url; do
        local arch_tag emu_note
        if [[ "$url" =~ arm64|aarch64 ]]; then
            arch_tag="arm64"
            [[ $_emu64 -eq 1 ]] && emu_note="✓ emulatable" || emu_note="✗ install qemu-system-arm"
        elif [[ "$url" =~ armhf ]]; then
            arch_tag="armhf"
            [[ $_emu32 -eq 1 ]] && emu_note="✓ emulatable" || emu_note="✗ install qemu-system-arm"
        else
            arch_tag="?"
            emu_note="? arch unknown"
        fi
        printf "  [%3s] %-52s [%s | %s]\n" "$idx" "$name" "$arch_tag" "$emu_note"
        max_idx=$idx
    done <<< "$entries"
    echo ""
    echo "  Pi Zero/1/2 use armhf images; Pi 3B+ and up use arm64."
    echo ""

    read -rp "Select image [1-$max_idx] or q to cancel: " sel
    [[ "$sel" == "q" || "$sel" == "Q" ]] && { echo "Cancelled."; return; }
    [[ "$sel" =~ ^[0-9]+$ && "$sel" -ge 1 && "$sel" -le "$max_idx" ]] || die "Invalid selection"

    local chosen_url chosen_name chosen_arch chosen_emu=0
    chosen_url=$(awk -v idx="$sel" 'NR==idx {print $3}' FS=$'\t' <<< "$entries")
    chosen_name=$(awk -v idx="$sel" 'NR==idx {print $2}' FS=$'\t' <<< "$entries")
    if [[ "$chosen_url" =~ arm64|aarch64 ]]; then
        chosen_arch="arm64"; [[ $_emu64 -eq 1 ]] && chosen_emu=1
    elif [[ "$chosen_url" =~ armhf ]]; then
        chosen_arch="armhf"; [[ $_emu32 -eq 1 ]] && chosen_emu=1
    else
        chosen_arch="unknown"
    fi
    rm -f "$tmp"

    if [[ $chosen_emu -eq 0 ]]; then
        echo ""
        echo "  ⚠  '$chosen_name' ($chosen_arch) cannot be emulated with the current QEMU setup."
        echo "     You can still download it to flash to a real Raspberry Pi (rpi flash)."
        echo "     To enable emulation: sudo apt install qemu-system-arm qemu-utils"
        echo ""
        read -rp "  Download anyway? [y/N]: " _proceed
        [[ "${_proceed,,}" == "y" ]] || { echo "Cancelled."; return; }
    fi

    local filename dest
    filename=$(basename "$chosen_url")
    dest="$IMAGES_DIR/$filename"

    echo ""
    echo "Downloading: $chosen_name"
    echo "Destination: $dest"
    echo ""

    wget -c "$chosen_url" -O "$dest"

    local final_img="$dest"
    if [[ "$dest" == *.xz ]]; then
        echo ""
        echo "Decompressing..."
        xz -d "$dest"
        final_img="${dest%.xz}"
        echo "Extracted: $final_img"
    elif [[ "$dest" == *.zip ]]; then
        echo ""
        echo "Decompressing..."
        unzip -o "$dest" -d "$IMAGES_DIR"
        rm -f "$dest"
        final_img=$(ls -t "$IMAGES_DIR"/*.img 2>/dev/null | head -1)
    fi

    echo ""
    read -rp "Give this image a label? (press ENTER to skip): " lbl_input
    if [[ -n "$lbl_input" ]]; then
        cmd_label "$lbl_input" "$final_img"
        final_img="$IMAGES_DIR/${lbl_input}__$(basename "$final_img")"
    else
        echo "Done. Run 'rpi list' to see your images."
    fi

    echo ""
    echo "=== Set login credentials ==="
    local cred_user cred_pass cred_pass2
    read -rp "  Username [pi]: " cred_user
    [[ -z "$cred_user" ]] && cred_user="pi"
    while true; do
        read -rsp "  Password [raspberry]: " cred_pass; echo ""
        [[ -z "$cred_pass" ]] && cred_pass="raspberry" && break
        read -rsp "  Confirm password: " cred_pass2; echo ""
        [[ "$cred_pass" == "$cred_pass2" ]] && break
        echo "  Passwords do not match, try again."
    done
    local cred_slug; cred_slug=$(slug "$final_img")
    mkdir -p "$CONFIGS_DIR"
    printf 'USER=%s\nPASS=%s\n' "$cred_user" "$cred_pass" > "$CONFIGS_DIR/${cred_slug}.creds"
    info "Credentials saved: $cred_user / (password set)"
}

# ── cmd: shell (Docker-based, no apt needed) ──────────────────────────────────

cmd_shell() {
    local img="${1:-}"
    [[ -z "$img" ]] && img=$(pick_image)
    [[ -f "$img" ]] || img="$IMAGES_DIR/$img"
    [[ -f "$img" ]] || die "Image not found: $img"

    echo ""
    read -rp "Shell as user [root]: " shell_user
    shell_user="${shell_user:-root}"

    local name; name=$(_image_display_name "$img")
    echo ""
    echo "=== Quick Shell: $name (user: $shell_user) ==="
    info "Mounting image and opening arm64 shell via Docker..."
    echo "Type 'exit' to leave the Pi shell."
    echo ""

    if [[ "$shell_user" == "root" ]]; then
        docker_chroot_run "$img" "1" "bridge"
    else
        docker_chroot_run "$img" "1" "bridge" su - "$shell_user" -s /bin/bash
    fi
}

# ── cmd: run (full QEMU emulation) ───────────────────────────────────────────

cmd_run() {
    local verbose=0
    while [[ "${1:-}" == -* ]]; do
        case "$1" in
            -v|--verbose) verbose=1; shift ;;
            *) die "Unknown flag: $1" ;;
        esac
    done
    local img="${1:-}"
    [[ -z "$img" ]] && img=$(pick_image)
    [[ -f "$img" ]] || img="$IMAGES_DIR/$img"
    [[ -f "$img" ]] || die "Image not found: $img"

    if ! command -v qemu-system-aarch64 &>/dev/null; then
        echo ""
        echo "Full QEMU emulation requires qemu-system-arm."
        echo "Install it with:"
        echo "  sudo apt install -y qemu-system-arm qemu-utils"
        echo ""
        echo "After installing, re-run: rpi run"
        echo ""
        echo "Alternatively, use 'rpi shell' for instant arm64 access via Docker (no install needed)."
        return 1
    fi

    command -v fdisk &>/dev/null || die "fdisk not found"

    local name; name=$(slug "$img")
    local disk="$DISKS_DIR/$name.qcow2"
    local kdir="$KERNELS_DIR/$name"
    local extra_fwds; extra_fwds=$(_load_extra_hostfwds "$name")

    # Load per-image credentials (set during download; fall back to defaults)
    local creds_file="$CONFIGS_DIR/${name}.creds"
    if [[ -f "$creds_file" ]]; then
        local _u _p
        _u=$(grep '^USER=' "$creds_file" | cut -d= -f2-)
        _p=$(grep '^PASS=' "$creds_file" | cut -d= -f2-)
        [[ -n "$_u" ]] && DEFAULT_USER="$_u"
        [[ -n "$_p" ]] && DEFAULT_PASS="$_p"
    fi

    # Machine selection — persisted in configs/<slug>.machine
    local machine_file="$CONFIGS_DIR/${name}.machine"
    local machine_key
    if [[ -f "$machine_file" ]]; then
        machine_key=$(cat "$machine_file")
        _machine_prop "$machine_key" qemu &>/dev/null || {
            info "Unknown machine '$machine_key', re-selecting..."
            machine_key=$(_pick_machine)
            echo "$machine_key" > "$machine_file"
        }
    else
        machine_key=$(_pick_machine)
        mkdir -p "$CONFIGS_DIR"
        echo "$machine_key" > "$machine_file"
    fi
    local qemu_bin qemu_machine cpu ram kernel_file dtb_file
    qemu_bin=$(_machine_prop "$machine_key" qemu_bin)
    qemu_machine=$(_machine_prop "$machine_key" qemu)
    cpu=$(_machine_prop "$machine_key" cpu)
    ram=$(_machine_prop "$machine_key" ram)
    kernel_file=$(_machine_prop "$machine_key" kernel)
    dtb_file=$(_machine_prop "$machine_key" dtb)
    command -v "$qemu_bin" &>/dev/null || die "$qemu_bin not found — install with: sudo apt install qemu-system-arm"
    _qemu_supports_machine "$qemu_bin" "$qemu_machine" || \
        die "$(_machine_prop "$machine_key" display) requires QEMU 9+. Build from source: https://www.qemu.org/download/ — or add a custom entry to $CONFIGS_DIR/machines.conf"

    # Re-extract if the kernel or DTB for the selected machine is missing
    # For raspi4b also require initrd (built from boot partition)
    local need_initrd=0
    [[ "$qemu_machine" == "raspi4b" ]] && need_initrd=1
    { [[ -f "$kdir/$kernel_file" ]] && [[ -f "$kdir/$dtb_file" ]] && { [[ $need_initrd -eq 0 ]] || [[ -f "$kdir/initrd" ]]; }; } || rm -rf "$kdir"

    # For Pi 4B: rebuild initrd if credentials changed since last build
    if [[ "$qemu_machine" == "raspi4b" && -f "$kdir/initrd" && -f "$creds_file" ]]; then
        if [[ "$creds_file" -nt "$kdir/initrd" ]]; then
            info "Credentials updated — rebuilding initrd..."
            _pi4b_build_initrd "$kdir" "$DEFAULT_USER" "$DEFAULT_PASS" && info "Rebuilt Pi 4B initrd with new credentials"
        fi
    fi

    echo ""
    echo "=== Preparing: $name ==="

    if [[ ! -f "$kdir/$kernel_file" ]]; then
        info "Extracting kernel and DTBs from boot partition..."
        mkdir -p "$kdir"

        local mnt loop_dev
        mnt=$(mktemp -d /tmp/rpi-boot.XXXXXX)
        loop_dev=$(sudo losetup --find --show --partscan "$img") || die "losetup failed for $img"
        sudo mount "${loop_dev}p1" "$mnt"

        # Extract all kernels present (different Pi models need different ones)
        for k in kernel.img kernel7.img kernel7l.img kernel8.img kernel_2712.img; do
            [[ -f "$mnt/$k" ]] && cp "$mnt/$k" "$kdir/"
        done
        [[ -f "$kdir/$kernel_file" ]] || {
            sudo umount "$mnt"; sudo losetup -d "$loop_dev"
            die "$kernel_file not found — this image may not support $(_machine_prop "$machine_key" display). Try a 32-bit armhf image for Pi Zero/1/2."
        }

        # Extract all DTBs so any machine target is available without re-extraction.
        # Search root and broadcom/ subdir (used in some Bookworm/Trixie images).
        local dtb_count=0
        local search_dirs=("$mnt" "$mnt/broadcom")
        for sdir in "${search_dirs[@]}"; do
            [[ -d "$sdir" ]] || continue
            for dtb_src in "$sdir"/bcm27*.dtb "$sdir"/bcm28*.dtb; do
                if [[ -f "$dtb_src" ]]; then cp "$dtb_src" "$kdir/"; dtb_count=$((dtb_count + 1)); fi
            done
        done
        [[ $dtb_count -eq 0 ]] && { sudo umount "$mnt"; sudo losetup -d "$loop_dev"; die "No DTB files found in image"; }

        sudo touch "$mnt/ssh"

        local hashed
        hashed=$(echo "$DEFAULT_PASS" | openssl passwd -6 -stdin)
        echo "${DEFAULT_USER}:${hashed}" | sudo tee "$mnt/userconf.txt" >/dev/null
        info "Created user: $DEFAULT_USER / $DEFAULT_PASS"

        # Pi 4B: extract initrd from boot partition for patching
        if [[ "$qemu_machine" == "raspi4b" ]]; then
            local orig_initrd=""
            for iname in initramfs8 initrd.img initramfs.img; do
                [[ -f "$mnt/$iname" ]] && orig_initrd="$mnt/$iname" && break
            done
            # Also check versioned names
            [[ -z "$orig_initrd" ]] && orig_initrd=$(ls "$mnt"/initramfs-* "$mnt"/initrd.img-* 2>/dev/null | head -1)
            [[ -n "$orig_initrd" ]] && cp "$orig_initrd" "$kdir/initrd.orig"
        fi

        sudo umount "$mnt"

        # Pre-configure root partition: SSH host keys + password auth config + entropy seed.
        # Done here on the img before qemu-img convert so the qcow2 has it baked in.
        # Pi 4B handles SSH keys via initrd; apply to all machines anyway (harmless to re-do).
        local rmnt
        rmnt=$(mktemp -d /tmp/rpi-root.XXXXXX)
        if sudo mount "${loop_dev}p2" "$rmnt" 2>/dev/null; then
            # SSH host keys — avoids entropy hang on first boot inside QEMU
            if [[ -d "$rmnt/etc/ssh" ]]; then
                sudo mkdir -p "$rmnt/etc/ssh/sshd_config.d"
                printf 'PasswordAuthentication yes\nPermitRootLogin yes\n' | \
                    sudo tee "$rmnt/etc/ssh/sshd_config.d/99-qemu.conf" >/dev/null
                for _kt in rsa ecdsa ed25519; do
                    local _kf="/tmp/rpi-hostkey-$$-${_kt}"
                    ssh-keygen -q -N "" -t "$_kt" -f "$_kf" 2>/dev/null || continue
                    sudo mv "$_kf"     "$rmnt/etc/ssh/ssh_host_${_kt}_key"
                    sudo mv "$_kf.pub" "$rmnt/etc/ssh/ssh_host_${_kt}_key.pub"
                    sudo chown root:root "$rmnt/etc/ssh/ssh_host_${_kt}_key" \
                                         "$rmnt/etc/ssh/ssh_host_${_kt}_key.pub" 2>/dev/null || true
                    sudo chmod 600 "$rmnt/etc/ssh/ssh_host_${_kt}_key"
                    sudo chmod 644 "$rmnt/etc/ssh/ssh_host_${_kt}_key.pub"
                done
                info "Pre-generated SSH host keys"
            fi
            # Seed entropy file so systemd-random-seed has something on first boot
            if [[ -d "$rmnt/var/lib/systemd" ]]; then
                dd if=/dev/urandom bs=512 count=1 2>/dev/null | \
                    sudo tee "$rmnt/var/lib/systemd/random-seed" >/dev/null
                sudo chmod 600 "$rmnt/var/lib/systemd/random-seed" 2>/dev/null || true
            fi
            sudo umount "$rmnt"
        fi
        rm -rf "$rmnt"

        sudo losetup -d "$loop_dev"
        rm -rf "$mnt"
        info "Kernel and DTB extracted to $kdir/"

        # Pi 4B post-extraction: patch DTB for USB OTG and build custom initrd
        if [[ "$qemu_machine" == "raspi4b" ]]; then
            _pi4b_patch_dtb "$kdir/$dtb_file" && info "Patched DTB: USB OTG enabled"
            _pi4b_build_initrd "$kdir" "$DEFAULT_USER" "$DEFAULT_PASS" && info "Built Pi 4B initrd"
        fi
    fi

    if [[ ! -f "$disk" ]]; then
        info "Converting to qcow2 (first run only)..."
        qemu-img convert -f raw -O qcow2 "$img" "$disk"
        info "Disk: $disk"
    else
        info "Using existing disk: $disk"
    fi

    # QEMU raspi3b requires the virtual disk size to be a power of 2.
    # Round up if needed (e.g. 6 GiB → 8 GiB).
    local size_bytes pow2
    size_bytes=$(qemu-img info --output=json "$disk" | jq '."virtual-size"')
    if [[ "$size_bytes" =~ ^[0-9]+$ ]]; then
        pow2=1073741824  # start at 1 GiB
        while [[ $pow2 -lt $size_bytes ]]; do (( pow2 *= 2 )); done
        if [[ $pow2 -gt $size_bytes ]]; then
            local pow2_g=$(( pow2 / 1073741824 ))
            qemu-img resize "$disk" "${pow2_g}G" >/dev/null
            info "Resized disk to ${pow2_g}G (QEMU SD card power-of-2 requirement)"
        fi
    fi

    # DTB fallback: if selected machine's DTB isn't in the kdir, find the best substitute.
    # 1) Same chip family (bcm2710-rpi-2-b.dtb works for raspi3b in QEMU — copy under expected name)
    # 2) If no same-chip DTB, auto-select the best machine whose chip IS represented
    if [[ ! -f "$kdir/$dtb_file" ]]; then
        local _chip; _chip=$(echo "$dtb_file" | cut -d'-' -f1)
        local _compat; _compat=$(ls "$kdir/${_chip}"*.dtb 2>/dev/null | head -1)
        if [[ -n "$_compat" ]]; then
            cp "$_compat" "$kdir/$dtb_file"
            info "Note: using compatible DTB '$(basename "$_compat")' for $(_machine_prop "$machine_key" display)"
        else
            # No same-chip DTB — pick the first QEMU-supported machine whose chip IS present
            local _fallback_key=""
            for _fb_entry in "${_MACHINE_TABLE[@]}"; do
                local _fk _fbin _fmach _fdtb _fchip
                _fk="${_fb_entry%%|*}"
                _fbin=$(cut -d'|' -f3 <<< "$_fb_entry")
                _fmach=$(cut -d'|' -f4 <<< "$_fb_entry")
                _fdtb=$(cut -d'|' -f8 <<< "$_fb_entry")
                _qemu_supports_machine "$_fbin" "$_fmach" || continue
                _fchip=$(echo "$_fdtb" | cut -d'-' -f1)
                if ls "$kdir/${_fchip}"*.dtb &>/dev/null; then
                    _fallback_key="$_fk"
                    break
                fi
            done
            [[ -n "$_fallback_key" ]] || die "No supported machine DTB found. DTBs present: $(ls "$kdir"/*.dtb 2>/dev/null | xargs -n1 basename | tr '\n' ' ')  Run: rpi machine"
            machine_key="$_fallback_key"
            qemu_bin=$(_machine_prop "$machine_key" qemu_bin)
            qemu_machine=$(_machine_prop "$machine_key" qemu)
            cpu=$(_machine_prop "$machine_key" cpu)
            ram=$(_machine_prop "$machine_key" ram)
            kernel_file=$(_machine_prop "$machine_key" kernel)
            dtb_file=$(_machine_prop "$machine_key" dtb)
            echo "$machine_key" > "$machine_file"
            # Apply same-chip copy for the new machine's DTB
            if [[ ! -f "$kdir/$dtb_file" ]]; then
                local _c2; _c2=$(echo "$dtb_file" | cut -d'-' -f1)
                local _compat2; _compat2=$(ls "$kdir/${_c2}"*.dtb 2>/dev/null | head -1)
                [[ -n "$_compat2" ]] && cp "$_compat2" "$kdir/$dtb_file"
            fi
            info "Auto-selected $(_machine_prop "$machine_key" display) (image does not include Pi 4B DTB)"
            [[ -f "$kdir/$kernel_file" ]] || die "$kernel_file not found for $(_machine_prop "$machine_key" display). Run: rpi machine to reselect."
        fi
    fi

    local pid_file="/tmp/rpi-${name}.pid"
    if [[ -f "$pid_file" ]]; then
        local old_pid; old_pid=$(cat "$pid_file")
        if kill -0 "$old_pid" 2>/dev/null; then
            info "Already running (pid $old_pid). Connecting..."
            _ssh_connect
            return
        fi
        rm -f "$pid_file"
    fi

    # Machine-specific kernel command-line parameters
    local root_dev console_dev extra_kargs initrd_arg
    case "$qemu_machine" in
        raspi4b)
            root_dev="mmcblk1p2"
            console_dev="ttyAMA1"
            extra_kargs="earlycon=pl011,0xfe201000 bcm2835_wdt.heartbeat=0 fsck.mode=skip"
            initrd_arg="-initrd $kdir/initrd"
            ;;
        *)
            root_dev="mmcblk0p2"
            console_dev="ttyAMA0"
            extra_kargs=""
            initrd_arg=""
            ;;
    esac
    local kernel_append="root=/dev/${root_dev} rw rootfstype=ext4 rootwait console=${console_dev},115200 loglevel=3 net.ifnames=0 dwc_otg.lpm_enable=0 ${extra_kargs}"

    echo ""
    echo "=== Starting QEMU ($(_machine_prop "$machine_key" display)) ==="
    info "Login: $DEFAULT_USER / $DEFAULT_PASS"
    echo ""

    # LAN exposure: optionally bind SSH to a host port reachable from the network
    local lan_fwd="" lan_ip=""
    lan_ip=$(ip route get 8.8.8.8 2>/dev/null | grep -oP 'src \K[0-9.]+' | head -1)
    [[ -z "$lan_ip" ]] && lan_ip=$(hostname -I 2>/dev/null | awk '{print $1}')
    if [[ -n "$lan_ip" ]]; then
        local lan_port_input
        read -rp "Expose SSH on LAN? Enter a port number >=1024 (or Enter to skip): " lan_port_input
        if [[ -n "$lan_port_input" ]]; then
            if [[ "$lan_port_input" =~ ^[0-9]+$ && "$lan_port_input" -ge 1024 && "$lan_port_input" -le 65535 ]]; then
                lan_fwd=",hostfwd=tcp::${lan_port_input}-:22"
                info "LAN SSH: ssh -p ${lan_port_input} ${DEFAULT_USER}@${lan_ip}"
            elif [[ "$lan_port_input" =~ ^[0-9]+$ && "$lan_port_input" -lt 1024 ]]; then
                echo "  Port $lan_port_input is below 1024 — requires root to bind. Skipping LAN exposure."
                echo "  Try a port >= 1024 (e.g. 2200, 4222, 5022)."
            else
                echo "  Invalid port '$lan_port_input'. Skipping LAN exposure."
            fi
        fi
    fi
    info "Local SSH: ssh -p $SSH_PORT $DEFAULT_USER@localhost"
    echo ""

    local serial_log="/tmp/rpi-${name}-serial.log"

    # Build the base QEMU arg array (shared between daemonized and foreground modes)
    local qemu_base_args=(
        -M "$qemu_machine"
        -cpu "$cpu"
        -m "$ram"
        -kernel "$kdir/$kernel_file"
        -dtb "$kdir/$dtb_file"
        -drive "file=$disk,format=qcow2,if=sd"
        -append "$kernel_append"
        -netdev "user,id=net0,hostfwd=tcp::${SSH_PORT}-:22${extra_fwds}${lan_fwd}"
        -device usb-net,netdev=net0
    )
    # shellcheck disable=SC2206
    [[ -n "$initrd_arg" ]] && qemu_base_args+=($initrd_arg)

    if [[ $verbose -eq 1 ]]; then
        rm -f "$serial_log"
        touch "$serial_log"
        qemu_base_args+=(-chardev "file,id=ser0,path=${serial_log}" -serial chardev:ser0 -monitor none)
    else
        qemu_base_args+=(-serial null -monitor none)
    fi

    # shellcheck disable=SC2086
    "$qemu_bin" "${qemu_base_args[@]}" \
        -nographic -daemonize \
        -pidfile "$pid_file" 2>/dev/null || {
            echo "Running in foreground (Ctrl+A X to quit QEMU)..."
            "$qemu_bin" "${qemu_base_args[@]}" -nographic
            return
        }
    local qemu_pid; qemu_pid=$(cat "$pid_file" 2>/dev/null || true)

    local tail_pid=""
    if [[ $verbose -eq 1 ]]; then
        echo "Waiting for SSH — serial output:"
        echo "─────────────────────────────────"
        tail -f "$serial_log" 2>/dev/null &
        tail_pid=$!
    else
        echo "Waiting for SSH (may take 1-2 minutes)..."
    fi

    local deadline=$(( $(date +%s) + 300 ))
    # sshd is socket-activated: keep each connection open long enough for sshd to start
    # (short-lived connections just re-arm the socket without getting a banner)
    while true; do
        if [[ $(date +%s) -ge $deadline ]]; then
            [[ -n "$tail_pid" ]] && kill "$tail_pid" 2>/dev/null
            echo ""
            echo "Timed out. Pi is still booting — try again in a moment:"
            echo "  ssh -p $SSH_PORT $DEFAULT_USER@localhost"
            echo "  rpi stop $name"
            return 1
        fi
        ps -p "$qemu_pid" > /dev/null 2>&1 || {
            [[ -n "$tail_pid" ]] && kill "$tail_pid" 2>/dev/null
            echo ""; echo "VM exited unexpectedly."; return 1
        }
        if timeout 90 bash -c "exec 3<>/dev/tcp/localhost/$SSH_PORT 2>/dev/null && read -u 3 -t 75 line 2>/dev/null && [[ \"\$line\" == SSH* ]]" 2>/dev/null; then
            break
        fi
        [[ $verbose -eq 0 ]] && printf "."
        sleep 2
    done

    if [[ -n "$tail_pid" ]]; then
        kill "$tail_pid" 2>/dev/null
        wait "$tail_pid" 2>/dev/null
        echo "─────────────────────────────────"
    fi
    echo " ready!"
    echo ""

    _ssh_connect

    echo ""
    read -rp "Keep VM running in background? [Y/n]: " keep
    if [[ "${keep,,}" == "n" ]]; then
        local pid; pid=$(cat "$pid_file" 2>/dev/null || true)
        [[ -n "$pid" ]] && kill "$pid" 2>/dev/null && info "VM stopped."
        rm -f "$pid_file"
    else
        info "VM running. To reconnect: rpi run"
        info "To stop: rpi stop $name"
    fi
}

_ssh_connect() {
    TERM="${TERM:-xterm-256color}" ssh \
        -o StrictHostKeyChecking=no \
        -o UserKnownHostsFile=/dev/null \
        -o LogLevel=ERROR \
        -o SendEnv=TERM \
        -p "$SSH_PORT" \
        "$DEFAULT_USER@localhost"
}

# ── cmd: stop ─────────────────────────────────────────────────────────────────

cmd_stop() {
    local name="${1:-}"
    if [[ -z "$name" ]]; then
        echo ""
        echo "Running instances:"
        local found=0
        for pid_file in /tmp/rpi-*.pid; do
            [[ -e "$pid_file" ]] || continue
            local pid n
            pid=$(cat "$pid_file")
            n=$(basename "$pid_file" .pid | sed 's/^rpi-//')
            if kill -0 "$pid" 2>/dev/null; then
                info "$n (pid $pid)"
                found=$((found + 1))
            else
                rm -f "$pid_file"
            fi
        done
        [[ $found -eq 0 ]] && { info "None running."; return; }
        echo ""
        read -rp "Instance name to stop (or 'all'): " name
    fi

    if [[ "$name" == "all" ]]; then
        for pid_file in /tmp/rpi-*.pid; do
            [[ -e "$pid_file" ]] || continue
            local pid; pid=$(cat "$pid_file")
            kill "$pid" 2>/dev/null && info "Stopped $(basename "$pid_file" .pid | sed 's/^rpi-//')"
            rm -f "$pid_file"
        done
    else
        local pid_file="/tmp/rpi-${name}.pid"
        [[ -f "$pid_file" ]] || die "No running instance named: $name"
        local pid; pid=$(cat "$pid_file")
        kill "$pid" 2>/dev/null && info "Stopped $name (pid $pid)"
        rm -f "$pid_file"
    fi
}

# ── cmd: flash ────────────────────────────────────────────────────────────────

cmd_flash() {
    command -v lsblk &>/dev/null || die "lsblk not found"

    echo ""
    echo "=== Flash Image to SD Card ==="

    local sources=() labels=()
    for f in "$IMAGES_DIR"/*.img "$DISKS_DIR"/*.qcow2; do
        [[ -f "$f" ]] || continue
        sources+=("$f")
        local sz; sz=$(du -sh "$f" 2>/dev/null | cut -f1)
        if [[ "$f" == *.qcow2 ]]; then
            labels+=("$(basename "$f")  [$sz] (QEMU disk — will convert to .img)")
        else
            labels+=("$(_image_display_name "$f")  [$sz]")
        fi
    done

    [[ ${#sources[@]} -eq 0 ]] && die "No images found. Run: rpi download"

    echo ""
    echo "Select source image:"
    local i=1
    for lbl in "${labels[@]}"; do
        printf "  [%d] %s\n" "$i" "$lbl"
        ((i++))
    done
    echo ""
    read -rp "Image [1-$((i-1))]: " img_sel
    [[ "$img_sel" =~ ^[0-9]+$ && "$img_sel" -ge 1 && "$img_sel" -le $((i-1)) ]] || die "Invalid selection"

    local src="${sources[$((img_sel-1))]}"
    local flash_src="$src"

    if [[ "$src" == *.qcow2 ]]; then
        command -v qemu-img &>/dev/null || die "qemu-img required to convert .qcow2. Install: sudo apt install qemu-utils"
        local converted="$IMAGES_DIR/$(basename "${src%.qcow2}").converted.img"
        echo ""
        echo "Converting qcow2 → raw img..."
        qemu-img convert -f qcow2 -O raw "$src" "$converted"
        info "Converted: $converted"
        flash_src="$converted"
    fi

    local img_bytes; img_bytes=$(stat -c%s "$flash_src")
    local img_human; img_human=$(du -sh "$flash_src" | cut -f1)

    echo ""
    echo "Detecting removable drives (SD cards, USB)..."
    echo ""

    local devs=() dev_labels=()
    while IFS= read -r line; do
        local dev size model tran
        dev=$(echo "$line"   | jq -r '.name')
        size=$(echo "$line"  | jq -r '.size // "?"')
        model=$(echo "$line" | jq -r '.model // ""')
        tran=$(echo "$line"  | jq -r '.tran // ""')
        devs+=("/dev/$dev")
        dev_labels+=("/dev/$dev  $size  ${model}  [${tran}]")
    done < <(lsblk -d -o NAME,SIZE,MODEL,TRAN,RM --json 2>/dev/null \
        | jq -c '.blockdevices[] | select(.rm == true or .tran == "usb" or .tran == "sd")')

    if [[ ${#devs[@]} -eq 0 ]]; then
        echo "  No removable drives detected."
        echo ""
        echo "  Manual flash command:"
        echo "  sudo dd if=\"$flash_src\" of=/dev/sdX bs=4M status=progress conv=fsync"
        return 1
    fi

    local j=1
    for lbl in "${dev_labels[@]}"; do
        printf "  [%d] %s\n" "$j" "$lbl"
        ((j++))
    done
    echo ""
    read -rp "Target device [1-$((j-1))]: " dev_sel
    [[ "$dev_sel" =~ ^[0-9]+$ && "$dev_sel" -ge 1 && "$dev_sel" -le $((j-1)) ]] || die "Invalid selection"

    local target="${devs[$((dev_sel-1))]}"

    local dev_bytes; dev_bytes=$(lsblk -bdo SIZE "$target" 2>/dev/null | tail -1 | tr -d ' ')
    if [[ -n "$dev_bytes" && "$img_bytes" -gt "$dev_bytes" ]]; then
        local dev_human; dev_human=$(lsblk -do SIZE "$target" 2>/dev/null | tail -1 | tr -d ' ')
        echo ""
        echo "  WARNING: Image ($img_human) is larger than device ($dev_human)."
        read -rp "  Continue anyway? [y/N]: " force
        [[ "${force,,}" == "y" ]] || { echo "Aborted."; return 1; }
    fi

    local mounted; mounted=$(lsblk -lno MOUNTPOINT "$target" 2>/dev/null | grep -v '^$' || true)
    [[ -n "$mounted" ]] && sudo umount "${target}"?* 2>/dev/null || true

    echo ""
    echo "  ┌─────────────────────────────────────────────┐"
    echo "  │  ABOUT TO FLASH — ALL DATA WILL BE ERASED  │"
    echo "  └─────────────────────────────────────────────┘"
    echo ""
    printf "  Source : %s  (%s)\n" "$(_image_display_name "$flash_src")" "$img_human"
    printf "  Target : %s\n" "$target"
    echo ""
    read -rp "  Type the device path to confirm (e.g. $target): " confirm
    [[ "$confirm" == "$target" ]] || { echo "Confirmation mismatch. Aborted."; return 1; }

    echo ""
    echo "Flashing... (this may take several minutes)"
    echo ""
    sudo dd if="$flash_src" of="$target" bs=4M status=progress conv=fsync
    sync

    echo ""
    echo "Done! Safely eject the card and insert into your Raspberry Pi."
    echo ""
}

# ── cmd: imager ───────────────────────────────────────────────────────────────

cmd_imager() {
    if command -v rpi-imager &>/dev/null; then
        echo "Launching rpi-imager..."
        rpi-imager &
    else
        echo "rpi-imager not installed."
        echo "Install with: sudo apt install -y rpi-imager"
        echo "Or use 'rpi download' to download images via CLI."
    fi
}

# ── cmd: exec (non-interactive Docker chroot) ─────────────────────────────────

cmd_exec() {
    [[ $# -eq 0 ]] && die "Usage: rpi exec [image] <command> [args...]"

    local img; img=$(_parse_image_arg "$1")
    [[ -n "$img" ]] && shift

    [[ "${1:-}" == "--" ]] && shift
    [[ $# -eq 0 ]] && die "No command specified. Usage: rpi exec [image] <command> [args...]"

    [[ -z "$img" ]] && img=$(pick_image)

    docker_chroot_run "$img" "0" "bridge" "$@"
}

# ── cmd: ssh (non-interactive or interactive QEMU SSH) ────────────────────────

cmd_ssh() {
    local running_pid=""
    for pf in /tmp/rpi-*.pid; do
        [[ -e "$pf" ]] || continue
        local p; p=$(cat "$pf")
        if kill -0 "$p" 2>/dev/null; then
            running_pid="$p"
            break
        else
            rm -f "$pf"
        fi
    done
    [[ -n "$running_pid" ]] || die "No running QEMU instance. Start one with: rpi run"

    ssh -o StrictHostKeyChecking=no \
        -o UserKnownHostsFile=/dev/null \
        -o LogLevel=ERROR \
        -p "$SSH_PORT" \
        "$DEFAULT_USER@localhost" "$@"
}

# ── cmd: put (copy file into image) ───────────────────────────────────────────

cmd_put() {
    command -v fdisk &>/dev/null || die "fdisk not found"

    local img src dst
    if [[ $# -eq 3 ]]; then
        img="$1"; src="$2"; dst="$3"
        [[ -f "$img" ]] || img="$IMAGES_DIR/$img"
    elif [[ $# -eq 2 ]]; then
        img=$(pick_image); src="$1"; dst="$2"
    else
        die "Usage: rpi put [image] <local_src> <remote_dst>"
    fi

    [[ -f "$img" ]] || die "Image not found: $img"
    [[ -f "$src" ]] || die "Source file not found: $src"

    local sector_size root_offset
    sector_size=$(fdisk -l "$img" | awk '/^Sector size/ {print $4}')
    root_offset=$(fdisk -l "$img" | awk '/Linux/ {print $2 * '"$sector_size"'; exit}')

    local mnt; mnt=$(mktemp -d /tmp/rpi-root.XXXXXX)

    _cleanup_put() { sudo umount "$mnt" 2>/dev/null || true; rm -rf "$mnt"; }
    trap _cleanup_put EXIT INT TERM

    sudo mount -o loop,offset="$root_offset" "$img" "$mnt"
    sudo mkdir -p "$(dirname "$mnt/$dst")"
    sudo cp "$src" "$mnt/$dst"
    info "put: $src → $dst  [$(_image_display_name "$img")]"

    _cleanup_put
    trap - EXIT INT TERM
}

# ── cmd: get (copy file out of image) ─────────────────────────────────────────

cmd_get() {
    command -v fdisk &>/dev/null || die "fdisk not found"

    local img src dst
    if [[ $# -eq 3 ]]; then
        img="$1"; src="$2"; dst="$3"
        [[ -f "$img" ]] || img="$IMAGES_DIR/$img"
    elif [[ $# -eq 2 ]]; then
        img=$(pick_image); src="$1"; dst="$2"
    else
        die "Usage: rpi get [image] <remote_src> <local_dst>"
    fi

    [[ -f "$img" ]] || die "Image not found: $img"

    local sector_size root_offset
    sector_size=$(fdisk -l "$img" | awk '/^Sector size/ {print $4}')
    root_offset=$(fdisk -l "$img" | awk '/Linux/ {print $2 * '"$sector_size"'; exit}')

    local mnt; mnt=$(mktemp -d /tmp/rpi-root.XXXXXX)

    _cleanup_get() { sudo umount "$mnt" 2>/dev/null || true; rm -rf "$mnt"; }
    trap _cleanup_get EXIT INT TERM

    sudo mount -o loop,offset="$root_offset" "$img" "$mnt"
    [[ -e "$mnt/$src" ]] || { _cleanup_get; trap - EXIT INT TERM; die "Not found in image: $src"; }
    cp -r "$mnt/$src" "$dst"
    info "get: $src → $dst  [$(_image_display_name "$img")]"

    _cleanup_get
    trap - EXIT INT TERM
}

# ── cmd: machine ──────────────────────────────────────────────────────────────

cmd_machine() {
    local img="${1:-}"
    [[ -z "$img" ]] && img=$(pick_image)
    [[ -f "$img" ]] || img="$IMAGES_DIR/$img"
    [[ -f "$img" ]] || die "Image not found: $img"

    local name; name=$(slug "$img")
    local machine_file="$CONFIGS_DIR/${name}.machine"
    mkdir -p "$CONFIGS_DIR"

    local current=""
    [[ -f "$machine_file" ]] && current=$(cat "$machine_file")
    if [[ -n "$current" ]]; then
        info "Current target: $(_machine_prop "$current" display 2>/dev/null || echo "$current")"
    else
        info "No target set (will be prompted on next rpi run)"
    fi

    local new_key
    new_key=$(_pick_machine)
    echo "$new_key" > "$machine_file"
    info "Set to: $(_machine_prop "$new_key" display)"

    # Remove extracted kernels so the right DTB is pulled on next run
    local kdir="$KERNELS_DIR/$name"
    if [[ -d "$kdir" && ! -f "$kdir/$(_machine_prop "$new_key" dtb)" ]]; then
        rm -rf "$kdir"
        info "Cleared kernel cache (will re-extract DTB on next run)"
    fi
}

# ── cmd: resize ───────────────────────────────────────────────────────────────

cmd_resize() {
    local img="${1:-}"
    [[ -z "$img" ]] && img=$(pick_image)
    [[ -f "$img" ]] || img="$IMAGES_DIR/$img"
    [[ -f "$img" ]] || die "Image not found: $img"

    command -v parted    &>/dev/null || die "parted not found (sudo apt install parted)"
    command -v resize2fs &>/dev/null || die "resize2fs not found (sudo apt install e2fsprogs)"

    local name; name=$(slug "$img")
    local current_size; current_size=$(du -sh "$img" | cut -f1)

    echo ""
    echo "=== Resize Image: $name ==="
    info "Current size: $current_size"
    echo ""
    read -rp "  Add how many GB? [e.g. 4]: " add_gb
    [[ "$add_gb" =~ ^[0-9]+$ && "$add_gb" -ge 1 ]] || die "Enter a whole number >= 1"

    echo ""
    info "Extending image file by ${add_gb}G..."
    truncate -s "+${add_gb}G" "$img"

    info "Resizing partition 2 to fill new space..."
    sudo parted -s "$img" resizepart 2 100%

    info "Attaching image..."
    local loop_dev
    loop_dev=$(sudo losetup --find --show --partscan "$img") || die "losetup failed"

    info "Checking filesystem..."
    sudo e2fsck -f -y "${loop_dev}p2" || true

    info "Expanding filesystem..."
    sudo resize2fs "${loop_dev}p2"

    sudo losetup -d "$loop_dev"

    # Invalidate any existing qcow2 so QEMU rebuilds it at the new size
    local qcow2="$DISKS_DIR/${name}.qcow2"
    if [[ -f "$qcow2" ]]; then
        rm -f "$qcow2"
        info "Removed stale qcow2 disk (will be rebuilt at new size on next rpi run)"
    fi

    local new_size; new_size=$(du -sh "$img" | cut -f1)
    echo ""
    info "Done. Image is now $new_size."
}

# ── cmd: ports ────────────────────────────────────────────────────────────────

cmd_ports() {
    local img="${1:-}"
    [[ -z "$img" ]] && img=$(pick_image)
    [[ -f "$img" ]] || img="$IMAGES_DIR/$img"
    [[ -f "$img" ]] || die "Image not found: $img"

    local name; name=$(slug "$img")
    local ports_file="$CONFIGS_DIR/${name}.ports"
    mkdir -p "$CONFIGS_DIR"

    while true; do
        echo ""
        echo "=== Port Forwards: $name ==="
        local idx=1
        if [[ -f "$ports_file" ]]; then
            while IFS= read -r line; do
                local stripped="${line%%#*}"; stripped="${stripped// /}"
                [[ -z "$stripped" ]] && continue
                printf "  [%d] %s\n" "$idx" "$stripped"
                ((idx++))
            done < "$ports_file"
        fi
        [[ $idx -eq 1 ]] && info "(none configured)"
        echo ""
        echo "  [a] Add    [r] Remove    [q] Done"
        echo ""
        read -rp "  Select: " choice

        case "${choice,,}" in
            a)
                read -rp "  Host port  (on this machine, e.g. 8080): " hport
                read -rp "  Guest port (inside the VM,  e.g. 80):   " gport
                [[ "$hport" =~ ^[0-9]+$ && "$gport" =~ ^[0-9]+$ ]] || \
                    { echo "  Invalid port number."; continue; }
                [[ "$hport" -eq "$SSH_PORT" ]] && \
                    { echo "  Port $SSH_PORT is reserved for SSH."; continue; }
                [[ "$hport" -lt 1 || "$hport" -gt 65535 || "$gport" -lt 1 || "$gport" -gt 65535 ]] && \
                    { echo "  Port out of range (1-65535)."; continue; }
                grep -qE "^${hport}:" "$ports_file" 2>/dev/null && \
                    { echo "  Host port $hport is already mapped."; continue; }
                printf '%s:%s\n' "$hport" "$gport" >> "$ports_file"
                info "Added: localhost:$hport  →  guest:$gport"
                ;;
            r)
                [[ -f "$ports_file" ]] || { info "No forwards to remove."; continue; }
                read -rp "  Host port to remove: " hport
                [[ "$hport" =~ ^[0-9]+$ ]] || { echo "  Invalid."; continue; }
                local new_lines=()
                while IFS= read -r line; do
                    local stripped="${line%%#*}"; stripped="${stripped// /}"
                    if [[ "$stripped" =~ ^${hport}: ]]; then
                        info "Removed: $stripped"
                    else
                        new_lines+=("$line")
                    fi
                done < "$ports_file"
                if [[ ${#new_lines[@]} -gt 0 ]]; then
                    printf '%s\n' "${new_lines[@]}" > "$ports_file"
                else
                    > "$ports_file"
                fi
                ;;
            q) break ;;
            *) echo "  Invalid choice." ;;
        esac
    done
}

# ── cmd: delete ───────────────────────────────────────────────────────────────

cmd_delete() {
    local images=()
    local labels=()
    while IFS= read -r f; do
        images+=("$f")
        labels+=("$(_image_display_name "$f")")
    done < <(ls "$IMAGES_DIR"/*.img 2>/dev/null)

    if [[ ${#images[@]} -eq 0 ]]; then
        info "No images found."
        return
    fi

    echo ""
    echo "Installed images:"
    local i=1
    for lbl in "${labels[@]}"; do
        printf "  [%d] %s\n" "$i" "$lbl"
        i=$((i + 1))
    done
    echo "  [a] Delete ALL"
    echo ""
    read -rp "Select image to delete [1-$((i-1)) or a]: " sel

    local targets=()
    if [[ "${sel,,}" == "a" ]]; then
        targets=("${images[@]}")
    elif [[ "$sel" =~ ^[0-9]+$ && "$sel" -ge 1 && "$sel" -le $((i-1)) ]]; then
        targets=("${images[$((sel-1))]}")
    else
        echo "  Cancelled."
        return
    fi

    echo ""
    for img in "${targets[@]}"; do
        local n; n=$(slug "$img")
        read -rp "  Delete '$(_image_display_name "$img")' and all associated data? [y/N]: " confirm
        [[ "${confirm,,}" == "y" ]] || { echo "  Skipped."; continue; }

        # Stop running VM if any
        local pid_file="/tmp/rpi-${n}.pid"
        if [[ -f "$pid_file" ]]; then
            local pid; pid=$(cat "$pid_file")
            kill "$pid" 2>/dev/null && info "Stopped running VM: $n"
            rm -f "$pid_file"
        fi

        rm -f "$img"
        rm -f "$DISKS_DIR/${n}.qcow2"
        rm -rf "$KERNELS_DIR/${n}"
        rm -f "$CONFIGS_DIR/${n}.machine"
        rm -f "$CONFIGS_DIR/${n}.ports"
        rm -f "$CONFIGS_DIR/${n}.creds"
        info "Deleted: $n"
    done
}

# ── cmd: help ─────────────────────────────────────────────────────────────────

cmd_help() {
    cat <<EOF

  rpi — Raspberry Pi image manager

  COMMANDS
    rpi                               Interactive menu
    rpi list                          List local images and running VMs
    rpi download                      Download an official RPi OS image
    rpi label  <label> [image]        Give an image a display name
    rpi shell  [image]                Instant arm64 shell via Docker
    rpi exec   [image] <cmd...>       Run command non-interactively in image
    rpi put    [image] <src> <dst>    Copy a file into an image
    rpi get    [image] <src> <dst>    Extract a file from an image
    rpi resize [image]                Grow image root partition by N GB
    rpi ports  [image]                Configure LAN port forwards for an image
    rpi machine [image]               Change emulation target (Pi Zero / 1 / 2 / 3B / 3B+ / 3A+)
    rpi run    [-v] [image]            Full QEMU boot + SSH (needs qemu-system-arm)
                                        -v / --verbose  show serial output during boot
    rpi delete [image]                Delete an image and all associated data
    rpi ssh    [cmd...]               SSH to running QEMU VM (interactive or not)
    rpi flash  [image]                Flash image (or qcow2) to an SD card
    rpi stop   [name]                 Stop a running QEMU instance
    rpi imager                        Launch rpi-imager GUI
    rpi help                          This help text

  IMAGE LABELS
    rpi label homelab 2026-04-21-raspios-trixie-arm64-lite.img
    Renames the file to: homelab__2026-04-21-raspios-trixie-arm64-lite.img
    All commands display the label; slug (disk/kernel dir name) uses the label.

  PATHS
    Images:  $IMAGES_DIR
    Disks:   $DISKS_DIR
    Kernels: $KERNELS_DIR

  REQUIREMENTS
    rpi list/download:  curl, wget, jq  (usually pre-installed)
    rpi shell/exec:     docker, fdisk   (Docker already works on this machine)
    rpi run:            qemu-system-arm, qemu-utils (needs apt install)

  SSH (run mode)
    Host: localhost:$SSH_PORT
    User: $DEFAULT_USER / $DEFAULT_PASS

  WiFi / Bluetooth emulation
    rpi-wifi help
    rpi-bluetooth help

EOF
}

# ── interactive menu ──────────────────────────────────────────────────────────

cmd_menu() {
    while true; do
        local img_count=0
        compgen -G "$IMAGES_DIR/*.img" &>/dev/null && img_count=$(ls "$IMAGES_DIR"/*.img 2>/dev/null | wc -l)

        local running_count=0
        for pid_file in /tmp/rpi-*.pid; do
            [[ -e "$pid_file" ]] || continue
            local pid; pid=$(cat "$pid_file")
            if kill -0 "$pid" 2>/dev/null; then
                running_count=$((running_count + 1))
            else
                rm -f "$pid_file"
            fi
        done

        echo ""
        echo "╔══════════════════════════════════╗"
        echo "║   Raspberry Pi Manager           ║"
        printf "║   Images: %-4s  Running: %-4s    ║\n" "$img_count" "$running_count"
        echo "╠══════════════════════════════════╣"
        echo "║  [1] List images & instances     ║"
        echo "║  [2] Download image              ║"
        echo "║  [3] Label an image              ║"
        echo "║  [4] Shell into image (Docker)   ║"
        echo "║  [5] Exec command in image       ║"
        echo "║  [6] Put file into image         ║"
        echo "║  [7] Get file from image         ║"
        echo "║  [8] Run image (full QEMU)       ║"
        echo "║  [m] Change emulation target     ║"
        echo "║  [9] SSH to running VM           ║"
        echo "║  [0] Flash image to SD card      ║"
        echo "║  [s] Stop a running instance     ║"
        echo "║  [z] Resize image                ║"
        echo "║  [p] Port forwards               ║"
        echo "║  [i] Launch rpi-imager GUI       ║"
        echo "║  [x] Delete an image             ║"
        echo "║  [Q] Quit                        ║"
        echo "╚══════════════════════════════════╝"
        echo ""
        read -rp "  Select: " choice

        case "${choice,,}" in
            1) cmd_list ;;
            2) cmd_download ;;
            3) read -rp "  Label: " _lbl; cmd_label "$_lbl" ;;
            4) cmd_shell ;;
            5) read -rp "  Command: " _ecmd; cmd_exec $_ecmd ;;
            6) read -rp "  Source: " _psrc; read -rp "  Dest in image: " _pdst; cmd_put "$_psrc" "$_pdst" ;;
            7) read -rp "  Path in image: " _gsrc; read -rp "  Local dest: " _gdst; cmd_get "$_gsrc" "$_gdst" ;;
            8) read -rp "  Verbose boot output? [y/N]: " _vb
               if [[ "$_vb" =~ ^[Yy]$ ]]; then cmd_run --verbose; else cmd_run; fi ;;
            m) cmd_machine ;;
            9) cmd_ssh ;;
            0) cmd_flash ;;
            s) cmd_stop ;;
            z) cmd_resize ;;
            p) cmd_ports ;;
            i) cmd_imager ;;
            x) cmd_delete ;;
            q) echo "Bye."; exit 0 ;;
            *) echo "  Invalid choice." ;;
        esac
    done
}

# ── entrypoint ────────────────────────────────────────────────────────────────

mkdir -p "$IMAGES_DIR" "$DISKS_DIR" "$KERNELS_DIR"

case "${1:-menu}" in
    list)     cmd_list ;;
    download) cmd_download ;;
    label)    shift; cmd_label "$@" ;;
    machine)  cmd_machine "${2:-}" ;;
    run)      cmd_run "${2:-}" ;;
    shell)    cmd_shell "${2:-}" ;;
    exec)     shift; cmd_exec "$@" ;;
    ssh)      shift; cmd_ssh "$@" ;;
    put)      shift; cmd_put "$@" ;;
    get)      shift; cmd_get "$@" ;;
    flash)    cmd_flash ;;
    resize)   cmd_resize "${2:-}" ;;
    ports)    cmd_ports "${2:-}" ;;
    stop)     cmd_stop "${2:-}" ;;
    imager)   cmd_imager ;;
    delete)   cmd_delete ;;
    help|--help|-h) cmd_help ;;
    menu|*)   cmd_menu ;;
esac
